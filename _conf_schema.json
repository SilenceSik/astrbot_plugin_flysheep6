{
  "enabled": {
    "description": "启用每日定时查询与推送",
    "type": "bool",
    "default": true
  },
  "targets": {
    "description": "接收日报的会话唯一标识列表",
    "type": "list",
    "hint": "推荐在目标群聊或私聊中使用 /避难所订阅 自动写入",
    "default": []
  },
  "push_time": {
    "description": "每日推送时间",
    "type": "string",
    "hint": "24 小时制 HH:MM",
    "default": "09:00"
  },
  "timezone": {
    "description": "定时任务时区",
    "type": "string",
    "hint": "IANA 时区名称，例如 Asia/Shanghai",
    "default": "Asia/Shanghai"
  },
  "days": {
    "description": "查询最近多少天",
    "type": "int",
    "hint": "按滚动时间窗口计算，默认最近 72 小时",
    "default": 3
  },
  "category_ids": {
    "description": "游戏目录分类 ID",
    "type": "string",
    "hint": "逗号分隔；默认依次为 PC、VR、独立游戏、模拟器整合游戏",
    "default": "4,5,32,72"
  },
  "max_items": {
    "description": "单次最多展示的游戏数",
    "type": "int",
    "default": 30
  },
  "search_max_items": {
    "description": "定向搜索最多展示的游戏数",
    "type": "int",
    "default": 10
  },
  "intro_length": {
    "description": "每款游戏简介最大字符数",
    "type": "int",
    "default": 100
  },
  "max_message_chars": {
    "description": "单条消息最大字符数",
    "type": "int",
    "hint": "超过后自动拆分，避免平台截断",
    "default": 3500
  },
  "only_new_on_schedule": {
    "description": "定时任务只推送尚未推送过的文章",
    "type": "bool",
    "default": false
  },
  "notify_empty": {
    "description": "最近查询范围内没有游戏时也发送提示",
    "type": "bool",
    "default": false
  },
  "request_timeout": {
    "description": "网站请求超时秒数",
    "type": "int",
    "default": 20
  },
  "api_url": {
    "description": "flysheep WordPress 文章接口",
    "type": "string",
    "default": "https://www.flysheep6.com/wp-json/wp/v2/posts"
  }
}
